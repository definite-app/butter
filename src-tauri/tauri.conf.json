{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Butter",
  "identifier": "com.butter.app",
  "version": "0.1.0",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5155"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Butter",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "visible": true,
        "center": true,
        "maximized": true
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "entitlements": "./entitlements.plist",
      "minimumSystemVersion": "12.0",
      "infoPlist": "./Info.plist"
    }
  }
}
